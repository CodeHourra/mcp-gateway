--- /dev/null
+++ b/internal/config/session_mode_test.go
@@ -0,0 +1,25 @@
+package config
+
+import (
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestGatewaySessionModeSurvivesCopyMergeAndJSON(t *testing.T) {
+	base := &ServerConfig{Name: "fixture", SessionMode: "shared"}
+	copy := CopyServerConfig(base)
+	require.Equal(t, "shared", copy.SessionMode)
+	merged, _, err := MergeServerConfig(base, &ServerConfig{Name: "fixture", SessionMode: "isolated"}, DefaultMergeOptions())
+	require.NoError(t, err)
+	require.Equal(t, "isolated", merged.SessionMode)
+	unchanged, _, err := MergeServerConfig(base, &ServerConfig{Name: "fixture"}, DefaultMergeOptions())
+	require.NoError(t, err)
+	require.Equal(t, "shared", unchanged.SessionMode)
+	data, err := json.Marshal(base)
+	require.NoError(t, err)
+	var restored ServerConfig
+	require.NoError(t, json.Unmarshal(data, &restored))
+	require.Equal(t, "shared", restored.EffectiveSessionMode())
+	require.Equal(t, "isolated", (&ServerConfig{}).EffectiveSessionMode())
+}
