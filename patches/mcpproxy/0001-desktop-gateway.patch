new file mode 100644
index 0000000..921e404
--- /dev/null
+++ b/internal/httpapi/gateway_control.go
@@ -0,0 +1,93 @@
+package httpapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/upstream/managed"
+)
+
+type gatewayController interface {
+	GatewayState() managed.GatewayState
+	SetGatewayPaused(bool) managed.GatewayState
+	CancelOAuthFlow(context.Context, string) (bool, error)
+	RefreshGatewayOAuth(string) error
+	StopGateway(context.Context) error
+}
+type gatewayFullToolController interface {
+	CallToolFull(context.Context, string, map[string]any) (any, error)
+}
+
+func (s *Server) gatewayController(w http.ResponseWriter, r *http.Request) (gatewayController, bool) {
+	if !s.requireAdminRead(w, r, "Agent tokens cannot manage the gateway") {
+		return nil, false
+	}
+	controller, ok := s.controller.(gatewayController)
+	if !ok {
+		s.writeError(w, r, http.StatusNotImplemented, "Gateway controls unavailable")
+	}
+	return controller, ok
+}
+func (s *Server) handleGatewayState(w http.ResponseWriter, r *http.Request) {
+	if controller, ok := s.gatewayController(w, r); ok {
+		s.writeSuccess(w, controller.GatewayState())
+	}
+}
+func (s *Server) handleGatewayPause(w http.ResponseWriter, r *http.Request) {
+	controller, ok := s.gatewayController(w, r)
+	if !ok {
+		return
+	}
+	var input struct {
+		Paused *bool `json:"paused"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&input); err != nil || input.Paused == nil {
+		s.writeError(w, r, http.StatusBadRequest, "paused boolean is required")
+		return
+	}
+	s.writeSuccess(w, controller.SetGatewayPaused(*input.Paused))
+}
+func (s *Server) handleGatewayOAuthCancel(w http.ResponseWriter, r *http.Request) {
+	controller, ok := s.gatewayController(w, r)
+	if !ok {
+		return
+	}
+	pending, err := controller.CancelOAuthFlow(r.Context(), chi.URLParam(r, "id"))
+	if err != nil {
+		s.writeError(w, r, http.StatusBadRequest, err.Error())
+		return
+	}
+	s.writeSuccess(w, map[string]any{"cancelled": pending})
+}
+func (s *Server) handleGatewayOAuthRefresh(w http.ResponseWriter, r *http.Request) {
+	controller, ok := s.gatewayController(w, r)
+	if !ok {
+		return
+	}
+	if err := controller.RefreshGatewayOAuth(chi.URLParam(r, "id")); err != nil {
+		s.writeError(w, r, http.StatusBadRequest, err.Error())
+		return
+	}
+	s.writeSuccess(w, map[string]any{"refreshed": true})
+}
+
+func (s *Server) handleGatewayStop(w http.ResponseWriter, r *http.Request) {
+	controller, ok := s.gatewayController(w, r)
+	if !ok {
+		return
+	}
+	var input struct {
+		Force bool `json:"force"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&input); err != nil || !input.Force {
+		s.writeError(w, r, http.StatusBadRequest, "force:true is required")
+		return
+	}
+	if err := controller.StopGateway(r.Context()); err != nil {
+		s.writeError(w, r, http.StatusInternalServerError, err.Error())
+		return
+	}
+	s.writeSuccess(w, controller.GatewayState())
+}
diff --git a/internal/server/gateway_control.go b/internal/server/gateway_control.go
new file mode 100644
index 0000000..500a3de
--- /dev/null
+++ b/internal/server/gateway_control.go
@@ -0,0 +1,45 @@
+package server
+
+import (
+	"context"
+
+	"github.com/mark3labs/mcp-go/mcp"
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/auth"
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/upstream/managed"
+)
+
+func (s *Server) GatewayState() managed.GatewayState {
+	return s.runtime.UpstreamManager().GatewayState()
+}
+func (s *Server) SetGatewayPaused(paused bool) managed.GatewayState {
+	return s.runtime.UpstreamManager().SetGatewayPaused(paused)
+}
+func (s *Server) CancelOAuthFlow(ctx context.Context, name string) (bool, error) {
+	return s.runtime.UpstreamManager().CancelOAuthFlow(ctx, name)
+}
+func (s *Server) RefreshGatewayOAuth(name string) error { return s.runtime.RefreshOAuthToken(name) }
+func (s *Server) CallToolFull(ctx context.Context, name string, args map[string]any) (any, error) {
+	return s.mcpProxy.callToolDirect(ctx, mcp.CallToolRequest{Params: mcp.CallToolParams{Name: name, Arguments: args}}, true)
+}
+
+// Management stays available over REST to the application. Agent discovery is
+// a fixed capability set, independent of the number of configured servers.
+func filterGatewayTools(ctx context.Context, tools []mcp.Tool) []mcp.Tool {
+	identity := auth.AuthContextFromContext(ctx)
+	if identity == nil || identity.IsAdmin() {
+		return tools
+	}
+	result := make([]mcp.Tool, 0, len(tools))
+	for _, tool := range tools {
+		switch tool.Name {
+		case "upstream_servers", "quarantine_security", "list_registries", "search_servers", "doctor", "set_profile":
+			continue
+		}
+		result = append(result, tool)
+	}
+	return result
+}
+
+func (s *Server) StopGateway(ctx context.Context) error {
+	return s.runtime.UpstreamManager().StopGateway(ctx)
+}
