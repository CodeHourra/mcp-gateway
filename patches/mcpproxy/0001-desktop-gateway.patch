+++ b/internal/upstream/managed/gateway_policy.go
@@ -0,0 +1,30 @@
+package managed
+
+import (
+	"errors"
+	"fmt"
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/storage"
+)
+
+// This final local policy check also covers REST history replay, which bypasses
+// the MCP wrapper. Unknown tools still receive the upstream's own response.
+func (mc *Client) gatewayToolPolicy(name string) error {
+	cfg := mc.GetConfig()
+	if cfg == nil || !cfg.Enabled {
+		return fmt.Errorf("server is disabled")
+	}
+	if cfg.Quarantined || !cfg.IsToolAllowedByConfig(name) {
+		return fmt.Errorf("tool is disabled by server policy")
+	}
+	if mc.storage == nil {
+		return fmt.Errorf("tool policy storage unavailable")
+	}
+	record, err := mc.storage.GetToolApproval(cfg.Name, name)
+	if err != nil && !errors.Is(err, storage.ErrToolApprovalNotFound) {
+		return fmt.Errorf("tool policy could not be checked: %w", err)
+	}
+	if record != nil && record.Disabled {
+		return fmt.Errorf("tool is disabled")
+	}
+	return nil
+}
diff --git a/internal/upstream/managed/session_clients.go b/internal/upstream/managed/session_clients.go
new file mode 100644
index 0000000..a31e866
--- /dev/null
+++ b/internal/upstream/managed/session_clients.go
@@ -0,0 +1,229 @@
+package managed
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	mcpserver "github.com/mark3labs/mcp-go/server"
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/auth"
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/upstream/core"
+)
+
+const sessionIdleTimeout = 15 * time.Minute
+
+type sessionClient struct {
+	client *core.Client
+	ready  chan struct{}
+	err    error
+	cancel context.CancelFunc
+	timer  *time.Timer
+	active int
+}
+
+// SessionKey binds server-side session identity to its authenticated caller.
+// REST management uses a separate, stable workspace from every agent session.
+// An agent REST call without a protocol session is refused for isolated servers.
+func SessionKey(ctx context.Context) (string, error) {
+	identity := auth.AuthContextFromContext(ctx)
+	if identity == nil || identity.Anonymous {
+		return "", fmt.Errorf("isolated calls require an authenticated session")
+	}
+	owner := identity.Type + ":" + identity.AgentName + ":" + identity.TokenPrefix + ":" + identity.UserID
+	if session := mcpserver.ClientSessionFromContext(ctx); session != nil {
+		return owner + ":mcp:" + session.SessionID(), nil
+	}
+	if identity.IsAdmin() {
+		return owner + ":management", nil
+	}
+	return "", fmt.Errorf("isolated agent calls require an MCP session; use /mcp/call or /mcp/all")
+}
+
+func (mc *Client) acquireSession(ctx context.Context) (*core.Client, func(), error) {
+	key, err := SessionKey(ctx)
+	if err != nil {
+		return nil, nil, err
+	}
+	mc.sessionMu.Lock()
+	if mc.sessionsClosing || !mc.IsConnected() {
+		mc.sessionMu.Unlock()
+		return nil, nil, fmt.Errorf("server disconnected before session admission")
+	}
+	if mc.sessions == nil {
+		mc.sessions = make(map[string]*sessionClient)
+	}
+	entry := mc.sessions[key]
+	if entry == nil {
+		lifetime, cancel := context.WithCancel(context.Background())
+		entry = &sessionClient{ready: make(chan struct{}), cancel: cancel}
+		mc.sessions[key] = entry
+		digest := sha256.Sum256([]byte(key))
+		id := mc.id + "-session-" + hex.EncodeToString(digest[:8])
+		go mc.connectSession(lifetime, id, entry)
+	}
+	if entry.timer != nil {
+		entry.timer.Stop()
+	}
+	entry.active++
+	mc.sessionMu.Unlock()
+	release := func() { mc.releaseSession(key, entry) }
+	select {
+	case <-ctx.Done():
+		release()
+		mc.expireSession(key, entry)
+		return nil, nil, ctx.Err()
+	case <-entry.ready:
+		if entry.err != nil {
+			release()
+			mc.expireSession(key, entry)
+			return nil, nil, entry.err
+		}
+		return entry.client, release, nil
+	}
+}
+
+func (mc *Client) connectSession(ctx context.Context, id string, entry *sessionClient) {
+	defer close(entry.ready)
+	entry.client, entry.err = mc.coreClient.NewSessionClient(id)
+	if entry.err != nil {
+		return
+	}
+	deadline := 30 * time.Second
+	if cfg := mc.GetConfig(); cfg.InitTimeout != nil && cfg.InitTimeout.Duration() > 0 {
+		deadline = cfg.InitTimeout.Duration()
+	}
+	connectCtx, cancel := context.WithTimeout(ctx, deadline)
+	defer cancel()
+	entry.err = entry.client.Connect(connectCtx)
+}
+
+func (mc *Client) releaseSession(key string, entry *sessionClient) {
+	mc.sessionMu.Lock()
+	defer mc.sessionMu.Unlock()
+	entry.active--
+	if mc.sessions[key] == entry && entry.active == 0 {
+		entry.timer = time.AfterFunc(sessionIdleTimeout, func() { mc.expireSession(key, entry) })
+	}
+}
+
+func (mc *Client) expireSession(key string, entry *sessionClient) {
+	mc.sessionMu.Lock()
+	if mc.sessions[key] != entry || entry.active > 0 {
+		mc.sessionMu.Unlock()
+		return
+	}
+	delete(mc.sessions, key)
+	mc.sessionMu.Unlock()
+	closeSessionClient(entry)
+}
+
+func closeSessionClient(entry *sessionClient) {
+	entry.cancel()
+	if entry.timer != nil {
+		entry.timer.Stop()
+	}
+	<-entry.ready
+	if entry.client != nil {
+		_ = entry.client.Disconnect()
+	}
+}
+
+func (mc *Client) CloseSession(key string) {
+	mc.sessionMu.Lock()
+	entry := mc.sessions[key]
+	delete(mc.sessions, key)
+	mc.sessionMu.Unlock()
+	if entry != nil {
+		closeSessionClient(entry)
+	}
+}
+
+func (mc *Client) closeSessions() {
+	mc.sessionMu.Lock()
+	entries := mc.sessions
+	mc.sessions = nil
+	mc.sessionMu.Unlock()
+	var wg sync.WaitGroup
+	for _, entry := range entries {
+		wg.Go(func() { closeSessionClient(entry) })
+	}
+	wg.Wait()
+}
+
+func (mc *Client) IsolatedSessionCount() int {
+	mc.sessionMu.Lock()
+	defer mc.sessionMu.Unlock()
+	return len(mc.sessions)
+}
+
+func (mc *Client) CloseMCPSession(sessionID string) {
+	mc.sessionMu.Lock()
+	var keys []string
+	for key := range mc.sessions {
+		if strings.HasSuffix(key, ":mcp:"+sessionID) {
+			keys = append(keys, key)
+		}
+	}
+	mc.sessionMu.Unlock()
+	for _, key := range keys {
+		mc.CloseSession(key)
+	}
+}
+
+func (mc *Client) CancelOAuthFlow(ctx context.Context) (bool, error) {
+	mc.oauthLoginMu.Lock()
+	login := mc.oauthLogin
+	mc.oauthLoginMu.Unlock()
+	if login == nil {
+		return mc.coreClient.CancelOAuthFlow(ctx)
+	}
+	pending, err := login.CancelOAuthFlow(ctx)
+	if err == nil {
+		mc.ClearManualOAuthClient(login)
+	}
+	return pending, err
+}
+
+func (mc *Client) SetManualOAuthClient(client *core.Client) error {
+	mc.oauthLoginMu.Lock()
+	defer mc.oauthLoginMu.Unlock()
+	if mc.oauthLogin != nil {
+		return fmt.Errorf("OAuth authorization already in progress")
+	}
+	mc.oauthLogin = client
+	return nil
+}
+
+func (mc *Client) ClearManualOAuthClient(client *core.Client) {
+	mc.oauthLoginMu.Lock()
+	if mc.oauthLogin == client {
+		mc.oauthLogin = nil
+	}
+	mc.oauthLoginMu.Unlock()
+}
+
+// A failed isolated transport must not evict the directory connection or peers.
+func (mc *Client) discardSessionClient(client *core.Client) {
+	mc.sessionMu.Lock()
+	var discarded *sessionClient
+	for key, entry := range mc.sessions {
+		select {
+		case <-entry.ready:
+		default:
+			continue
+		}
+		if entry.client == client {
+			delete(mc.sessions, key)
+			discarded = entry
+			break
+		}
+	}
+	mc.sessionMu.Unlock()
+	if discarded != nil {
+		closeSessionClient(discarded)
+	}
+}
