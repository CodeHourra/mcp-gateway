index 0000000..9245c91
--- /dev/null
+++ b/internal/upstream/core/session_client.go
@@ -0,0 +1,48 @@
+package core
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/oauth"
+)
+
+// NewSessionClient creates a distinct MCP transport/process while keeping the
+// server's existing configuration. Only the directory client owns OAuth flows
+// and refresh; child transports read the current access token for each request.
+func (c *Client) NewSessionClient(id string) (*Client, error) {
+	child, err := NewClient(id, c.config, c.logger, nil, c.globalConfig, c.storage, c.secretResolver)
+	if err != nil {
+		return nil, err
+	}
+	child.sessionParent = c
+	return child, nil
+}
+
+func (c *Client) sessionUsesOAuth() bool {
+	return c.sessionParent != nil && (c.config.OAuth != nil || c.sessionParent.GetOAuthHandler() != nil)
+}
+
+func (c *Client) sharedOAuthHeader(ctx context.Context) (string, error) {
+	c.refreshMu.Lock()
+	defer c.refreshMu.Unlock()
+	if c.storage == nil {
+		return "", fmt.Errorf("OAuth token storage is unavailable")
+	}
+	key := oauth.GenerateServerKey(c.config.Name, c.config.URL)
+	record, err := c.storage.GetOAuthToken(key)
+	if err != nil || record.AccessToken == "" {
+		return "", fmt.Errorf("OAuth sign-in required for %s", c.config.Name)
+	}
+	if !record.ExpiresAt.IsZero() && !record.ExpiresAt.After(time.Now()) {
+		if err := c.refreshOAuthTokenDirect(ctx); err != nil {
+			return "", err
+		}
+		record, err = c.storage.GetOAuthToken(key)
+		if err != nil {
+			return "", err
+		}
+	}
+	return "Bearer " + record.AccessToken, nil
+}
