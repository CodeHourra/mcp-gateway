@@ -0,0 +1,37 @@
+package transport
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"net/http"
+	"net/url"
+	"testing"
+)
+
+type gatewayRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f gatewayRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestGatewaySessionCredentialsRefreshAndStayOnOrigin(t *testing.T) {
+	origin, err := url.Parse("https://fixture.invalid/mcp")
+	require.NoError(t, err)
+	token := "first"
+	calls := 0
+	transport := &sessionAuthTransport{origin: origin, header: func(context.Context) (string, error) { calls++; return "Bearer " + token, nil }, next: gatewayRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, "Bearer "+token, r.Header.Get("Authorization"))
+		return &http.Response{StatusCode: 200}, nil
+	})}
+	request, err := http.NewRequestWithContext(t.Context(), "POST", origin.String(), nil)
+	require.NoError(t, err)
+	_, err = transport.RoundTrip(request)
+	require.NoError(t, err)
+	token = "rotated"
+	_, err = transport.RoundTrip(request)
+	require.NoError(t, err)
+	require.Empty(t, request.Header.Get("Authorization"), "caller request remains untouched")
+	foreign, err := http.NewRequestWithContext(t.Context(), "POST", "https://other.invalid/message", nil)
+	require.NoError(t, err)
+	_, err = transport.RoundTrip(foreign)
+	require.ErrorContains(t, err, "destination")
+	require.Equal(t, 2, calls, "foreign destinations never fetch credentials")
+}
