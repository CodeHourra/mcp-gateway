diff --git a/internal/storage/oauth_cipher.go b/internal/storage/oauth_cipher.go
new file mode 100644
index 0000000..e5355db
--- /dev/null
+++ b/internal/storage/oauth_cipher.go
@@ -0,0 +1,98 @@
+package storage
+
+import (
+	"bytes"
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"path/filepath"
+
+	"github.com/zalando/go-keyring"
+)
+
+const oauthKeychainService = "com.mcp-gateway.credentials"
+const oauthCipherPrefix = "MCPG-OAUTH-1:"
+
+var oauthKeyringGet = keyring.Get
+var oauthKeyringSet = keyring.Set
+
+// Each application data directory owns a key. Missing keys never replace a key
+// for existing ciphertext, and inaccessible Keychain storage never falls back
+// to a config file or an unencrypted database record.
+func (b *BoltDB) oauthAEAD(create bool) (cipher.AEAD, error) {
+	b.oauthCipherMu.Lock()
+	defer b.oauthCipherMu.Unlock()
+	if b.oauthCipher != nil {
+		return b.oauthCipher, nil
+	}
+	absDir, err := filepath.Abs(b.dataDir)
+	if err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256([]byte(absDir))
+	account := "oauth-master:" + hex.EncodeToString(digest[:16])
+	encoded, err := oauthKeyringGet(oauthKeychainService, account)
+	if errors.Is(err, keyring.ErrNotFound) && create {
+		key := make([]byte, 32)
+		if _, err = rand.Read(key); err != nil {
+			return nil, err
+		}
+		encoded = hex.EncodeToString(key)
+		clear(key)
+		if err = oauthKeyringSet(oauthKeychainService, account, encoded); err != nil {
+			return nil, fmt.Errorf("cannot save OAuth encryption key in Keychain: %w", err)
+		}
+		// Verify writes: a successful subprocess exit is not proof the item was
+		// persisted by a platform keyring implementation.
+		stored, readErr := oauthKeyringGet(oauthKeychainService, account)
+		if readErr != nil || stored != encoded {
+			return nil, fmt.Errorf("OAuth encryption key failed Keychain readback")
+		}
+	} else if err != nil {
+		return nil, fmt.Errorf("OAuth encryption key unavailable in Keychain: %w", err)
+	}
+	key, err := hex.DecodeString(encoded)
+	if err != nil || len(key) != 32 {
+		return nil, fmt.Errorf("OAuth Keychain key must contain 32 bytes")
+	}
+	defer clear(key)
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	b.oauthCipher, err = cipher.NewGCMWithRandomNonce(block)
+	return b.oauthCipher, err
+}
+
+func (b *BoltDB) encodeOAuthRecord(record *OAuthTokenRecord, createKey bool) ([]byte, error) {
+	aead, err := b.oauthAEAD(createKey)
+	if err != nil {
+		return nil, err
+	}
+	plain, err := record.MarshalBinary()
+	if err != nil {
+		return nil, err
+	}
+	defer clear(plain)
+	return aead.Seal([]byte(oauthCipherPrefix), nil, plain, []byte(record.ServerName)), nil
+}
+
+func (b *BoltDB) decodeOAuthRecord(serverKey string, data []byte, record *OAuthTokenRecord) error {
+	if !bytes.HasPrefix(data, []byte(oauthCipherPrefix)) {
+		return fmt.Errorf("unencrypted OAuth record refused; clear local authorization and sign in again")
+	}
+	aead, err := b.oauthAEAD(false)
+	if err != nil {
+		return err
+	}
+	plain, err := aead.Open(nil, nil, data[len(oauthCipherPrefix):], []byte(serverKey))
+	if err != nil {
+		return fmt.Errorf("OAuth credentials could not be authenticated: %w", err)
+	}
+	defer clear(plain)
+	return record.UnmarshalBinary(plain)
+}
diff --git a/internal/storage/oauth_cipher_test.go b/internal/storage/oauth_cipher_test.go
new file mode 100644
index 0000000..649e075
--- /dev/null
+++ b/internal/storage/oauth_cipher_test.go
@@ -0,0 +1,126 @@
+package storage
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/zalando/go-keyring"
+	"go.etcd.io/bbolt"
+	"go.uber.org/zap"
+)
+
+func gatewayTestKeychain(t *testing.T) map[string]string {
+	t.Helper()
+	values := map[string]string{}
+	oldGet, oldSet := oauthKeyringGet, oauthKeyringSet
+	oauthKeyringGet = func(service, account string) (string, error) {
+		value, ok := values[service+":"+account]
+		if !ok {
+			return "", keyring.ErrNotFound
+		}
+		return value, nil
+	}
+	oauthKeyringSet = func(service, account, value string) error { values[service+":"+account] = value; return nil }
+	t.Cleanup(func() { oauthKeyringGet, oauthKeyringSet = oldGet, oldSet })
+	return values
+}
+
+func TestGatewayOAuthCipherPersistence(t *testing.T) {
+	values := gatewayTestKeychain(t)
+	dir := t.TempDir()
+	db, err := NewBoltDB(dir, zap.NewNop().Sugar())
+	require.NoError(t, err)
+	record := &OAuthTokenRecord{ServerName: "fixture", AccessToken: "controlled-access-credential", RefreshToken: "controlled-refresh-credential", ClientID: "controlled-client-id", ClientSecret: "controlled-client-secret"}
+	require.NoError(t, db.SaveOAuthToken(record))
+	require.Len(t, values, 1)
+	var ciphertext []byte
+	require.NoError(t, db.db.View(func(tx *bbolt.Tx) error {
+		ciphertext = bytes.Clone(tx.Bucket([]byte(OAuthTokenBucket)).Get([]byte("fixture")))
+		return nil
+	}))
+	require.True(t, bytes.HasPrefix(ciphertext, []byte(oauthCipherPrefix)))
+	for _, credential := range []string{record.AccessToken, record.RefreshToken, record.ClientSecret} {
+		require.NotContains(t, string(ciphertext), credential)
+	}
+	require.NoError(t, db.SaveOAuthToken(record))
+	require.NoError(t, db.db.View(func(tx *bbolt.Tx) error {
+		require.NotEqual(t, ciphertext, tx.Bucket([]byte(OAuthTokenBucket)).Get([]byte("fixture")))
+		return nil
+	}))
+	require.NoError(t, db.Close())
+	for _, mode := range []struct {
+		path string
+		perm os.FileMode
+	}{{dir, 0700}, {filepath.Join(dir, "config.db"), 0600}} {
+		stat, e := os.Stat(mode.path)
+		require.NoError(t, e)
+		require.Equal(t, mode.perm, stat.Mode().Perm())
+	}
+	db, err = NewBoltDB(dir, zap.NewNop().Sugar())
+	require.NoError(t, err)
+	defer db.Close()
+	got, err := db.GetOAuthToken("fixture")
+	require.NoError(t, err)
+	require.Equal(t, record.RefreshToken, got.RefreshToken)
+	require.NoError(t, db.UpdateOAuthClientCredentials("fixture", "next-id", "next-secret", 12345))
+	id, secret, port, err := db.GetOAuthClientCredentials("fixture")
+	require.NoError(t, err)
+	require.Equal(t, "next-id", id)
+	require.Equal(t, "next-secret", secret)
+	require.Equal(t, 12345, port)
+	require.NoError(t, db.ClearOAuthClientCredentials("fixture"))
+	got, err = db.GetOAuthToken("fixture")
+	require.NoError(t, err)
+	require.Empty(t, got.ClientSecret)
+	require.Equal(t, record.AccessToken, got.AccessToken)
+	listed, err := db.ListOAuthTokens()
+	require.NoError(t, err)
+	require.Len(t, listed, 1)
+	require.NoError(t, db.DeleteOAuthToken("fixture"))
+	_, err = db.GetOAuthToken("fixture")
+	require.Error(t, err)
+}
+
+func TestGatewayOAuthCipherRefusesUnsafeRecovery(t *testing.T) {
+	values := gatewayTestKeychain(t)
+	db, err := NewBoltDB(t.TempDir(), zap.NewNop().Sugar())
+	require.NoError(t, err)
+	defer db.Close()
+	record := &OAuthTokenRecord{ServerName: "source", AccessToken: "secret-access"}
+	require.NoError(t, db.SaveOAuthToken(record))
+	var ciphertext []byte
+	require.NoError(t, db.db.View(func(tx *bbolt.Tx) error {
+		ciphertext = bytes.Clone(tx.Bucket([]byte(OAuthTokenBucket)).Get([]byte("source")))
+		return nil
+	}))
+	require.Error(t, db.decodeOAuthRecord("wrong-server", ciphertext, &OAuthTokenRecord{}))
+	ciphertext[len(ciphertext)-1] ^= 1
+	require.Error(t, db.decodeOAuthRecord("source", ciphertext, &OAuthTokenRecord{}))
+	require.ErrorContains(t, db.decodeOAuthRecord("source", []byte("plaintext legacy record"), &OAuthTokenRecord{}), "unencrypted")
+	db.oauthCipher = nil
+	clear(values)
+	_, err = db.GetOAuthToken("source")
+	require.ErrorContains(t, err, "unavailable")
+	require.Error(t, db.SaveOAuthToken(record))
+	require.Empty(t, values, "never create a replacement key over existing ciphertext")
+}
+
+func TestGatewayOAuthCipherKeychainFailureIsClosed(t *testing.T) {
+	gatewayTestKeychain(t)
+	db, err := NewBoltDB(t.TempDir(), zap.NewNop().Sugar())
+	require.NoError(t, err)
+	defer db.Close()
+	oauthKeyringGet = func(string, string) (string, error) { return "", errors.New("Keychain locked") }
+	require.ErrorContains(t, db.SaveOAuthToken(&OAuthTokenRecord{ServerName: "fixture", AccessToken: "never-persist"}), "Keychain locked")
+	oauthKeyringGet = func(string, string) (string, error) { return "", keyring.ErrNotFound }
+	oauthKeyringSet = func(string, string, string) error { return errors.New("write refused") }
+	require.ErrorContains(t, db.SaveOAuthToken(&OAuthTokenRecord{ServerName: "fixture", AccessToken: "never-persist"}), "write refused")
+	require.NoError(t, db.db.View(func(tx *bbolt.Tx) error {
+		require.Equal(t, 0, tx.Bucket([]byte(OAuthTokenBucket)).Stats().KeyN)
+		return nil
+	}))
+}
