new file mode 100644
index 0000000..2105044
--- /dev/null
+++ b/internal/transport/session_auth.go
@@ -0,0 +1,33 @@
+package transport
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/url"
+)
+
+// Upstream credentials may change after refresh, but their destination may not.
+// Guarding the actual request also protects static/custom headers, directory
+// OAuth clients and SSE message endpoints from cross-origin forwarding.
+type sessionAuthTransport struct {
+	next   http.RoundTripper
+	origin *url.URL
+	header func(context.Context) (string, error)
+}
+
+func (t *sessionAuthTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.Scheme != t.origin.Scheme || r.URL.Host != t.origin.Host {
+		return nil, fmt.Errorf("session credential destination does not match the upstream origin")
+	}
+	if t.header == nil {
+		return t.next.RoundTrip(r)
+	}
+	header, err := t.header(r.Context())
+	if err != nil {
+		return nil, err
+	}
+	copy := r.Clone(r.Context())
+	copy.Header.Set("Authorization", header)
+	return t.next.RoundTrip(copy)
+}
