@@ -0,0 +1,110 @@
+package transport
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/mark3labs/mcp-go/mcp"
+	"github.com/stretchr/testify/require"
+)
+
+func TestGatewayHTTPHeadersRefuseCrossOriginRedirect(t *testing.T) {
+	for _, credential := range []string{"custom", "bearer", "broker", "oauth"} {
+		t.Run(credential, func(t *testing.T) {
+			var foreignRequests, sourceRequests atomic.Int32
+			foreign := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				foreignRequests.Add(1)
+				w.WriteHeader(http.StatusInternalServerError)
+			}))
+			defer foreign.Close()
+			source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				sourceRequests.Add(1)
+				http.Redirect(w, r, foreign.URL+"/capture", http.StatusTemporaryRedirect)
+			}))
+			defer source.Close()
+			cfg := &HTTPTransportConfig{URL: source.URL + "/mcp"}
+			switch credential {
+			case "custom":
+				cfg.Headers = map[string]string{"X-Upstream-Key": "controlled-secret"}
+			case "bearer":
+				cfg.Headers = map[string]string{"Authorization": "Bearer controlled-secret"}
+			case "broker":
+				cfg.BrokeredAuth = &BrokeredAuth{Header: "X-Upstream-Key", Format: "{token}", Token: "controlled-secret"}
+			case "oauth":
+				cfg.UseOAuth, cfg.OAuthConfig = true, oauthTestConfig()
+			}
+			client, err := CreateHTTPClient(cfg)
+			require.NoError(t, err)
+			defer client.Close()
+			ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+			defer cancel()
+			require.NoError(t, client.Start(ctx))
+			_, err = client.Initialize(ctx, mcp.InitializeRequest{})
+			require.Error(t, err)
+			require.Positive(t, sourceRequests.Load())
+			require.Zero(t, foreignRequests.Load(), "no request or credential may reach the foreign origin")
+		})
+	}
+}
+
+func TestGatewayHTTPHeadersAllowSameOriginRedirect(t *testing.T) {
+	var captured atomic.Bool
+	source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/mcp" {
+			http.Redirect(w, r, "/accepted", http.StatusTemporaryRedirect)
+			return
+		}
+		captured.Store(r.Header.Get("X-Upstream-Key") == "controlled-secret")
+		var request struct {
+			ID json.RawMessage `json:"id"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&request)
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{"jsonrpc": "2.0", "id": request.ID,
+			"result": map[string]any{"protocolVersion": mcp.LATEST_PROTOCOL_VERSION, "capabilities": map[string]any{},
+				"serverInfo": map[string]any{"name": "same-origin", "version": "1"}}})
+	}))
+	defer source.Close()
+	client, err := CreateHTTPClient(&HTTPTransportConfig{URL: source.URL + "/mcp", Headers: map[string]string{"X-Upstream-Key": "controlled-secret"}})
+	require.NoError(t, err)
+	defer client.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	require.NoError(t, client.Start(ctx))
+	_, err = client.Initialize(ctx, mcp.InitializeRequest{})
+	require.NoError(t, err)
+	require.True(t, captured.Load())
+}
+
+func TestGatewaySSEHeadersRefuseForeignMessageEndpoint(t *testing.T) {
+	var foreignRequests atomic.Int32
+	foreign := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		foreignRequests.Add(1)
+		w.WriteHeader(http.StatusAccepted)
+	}))
+	defer foreign.Close()
+	source := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = fmt.Fprintf(w, "event: endpoint\ndata: %s/message\n\n", foreign.URL)
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+	}))
+	defer source.Close()
+	client, err := CreateSSEClient(&HTTPTransportConfig{URL: source.URL + "/sse", Headers: map[string]string{"X-Upstream-Key": "controlled-secret"}})
+	require.NoError(t, err)
+	defer client.Close()
+	ctx, cancel := context.WithTimeout(t.Context(), 3*time.Second)
+	defer cancel()
+	err = client.Start(ctx)
+	if err == nil {
+		_, err = client.Initialize(ctx, mcp.InitializeRequest{})
+	}
+	require.Error(t, err)
+	require.Zero(t, foreignRequests.Load(), "foreign SSE message endpoints must never receive a request")
+}
