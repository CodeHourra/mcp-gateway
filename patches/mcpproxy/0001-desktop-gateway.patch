diff --git a/internal/config/gateway_persistence_test.go b/internal/config/gateway_persistence_test.go
new file mode 100644
index 0000000..888a8c1
--- /dev/null
+++ b/internal/config/gateway_persistence_test.go
@@ -0,0 +1,36 @@
+package config
+
+import (
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestGatewayEnvironmentAPIKeyNeverPersists(t *testing.T) {
+	const key = "controlled-environment-management-key"
+	t.Setenv("MCPPROXY_API_KEY", key)
+	cfg := &Config{APIKey: key, Listen: "127.0.0.1:8080"}
+	path := filepath.Join(t.TempDir(), "core.json")
+	require.NoError(t, SaveConfig(cfg, path))
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.NotContains(t, string(data), key)
+	var saved map[string]any
+	require.NoError(t, json.Unmarshal(data, &saved))
+	require.NotContains(t, saved, "api_key")
+	require.Equal(t, key, cfg.APIKey, "persistence must not mutate live authentication")
+	again, err := MarshalForPersistence(cfg)
+	require.NoError(t, err)
+	require.JSONEq(t, string(data), string(again), "watcher compares the exact persisted projection")
+	cfg.ToolsLimit = 99
+	require.NoError(t, SaveConfig(cfg, path))
+	data, err = os.ReadFile(path)
+	require.NoError(t, err)
+	require.NotContains(t, string(data), key)
+	t.Setenv("MCPPROXY_API_KEY", "")
+	data, err = MarshalForPersistence(cfg)
+	require.NoError(t, err)
+	require.Contains(t, string(data), key, "standalone config-provided credentials retain upstream behavior")
+}
