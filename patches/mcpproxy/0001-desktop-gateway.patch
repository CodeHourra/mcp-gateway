@@ -0,0 +1,26 @@
+package core
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestGatewayOAuthCancelWaitsForCleanup(t *testing.T) {
+	client := &Client{}
+	ctx, finish, err := client.beginOAuthFlow(t.Context())
+	require.NoError(t, err)
+	_, _, err = client.beginOAuthFlow(t.Context())
+	require.Error(t, err)
+	done := make(chan struct{})
+	go func() { defer close(done); <-ctx.Done(); finish() }()
+	cancelled, err := client.CancelOAuthFlow(t.Context())
+	require.NoError(t, err)
+	require.True(t, cancelled)
+	<-done
+	cancelled, err = client.CancelOAuthFlow(t.Context())
+	require.NoError(t, err)
+	require.False(t, cancelled)
+	_, finish, err = client.beginOAuthFlow(t.Context())
+	require.NoError(t, err)
+	finish()
+}
diff --git a/internal/upstream/core/session_client.go b/internal/upstream/core/session_client.go
