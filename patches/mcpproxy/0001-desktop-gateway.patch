new file mode 100644
index 0000000..5e4d1e7
--- /dev/null
+++ b/internal/upstream/gateway_control.go
@@ -0,0 +1,48 @@
+package upstream
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/upstream/managed"
+)
+
+func (m *Manager) GatewayState() managed.GatewayState {
+	state := m.gateway.State()
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	for _, client := range m.clients {
+		state.IsolatedSessions += client.IsolatedSessionCount()
+	}
+	return state
+}
+
+func (m *Manager) SetGatewayPaused(paused bool) managed.GatewayState {
+	m.gateway.SetPaused(paused)
+	return m.GatewayState()
+}
+
+func (m *Manager) CloseMCPSession(sessionID string) {
+	m.mu.RLock()
+	clients := make([]*managed.Client, 0, len(m.clients))
+	for _, client := range m.clients {
+		clients = append(clients, client)
+	}
+	m.mu.RUnlock()
+	for _, client := range clients {
+		client.CloseMCPSession(sessionID)
+	}
+}
+
+func (m *Manager) CancelOAuthFlow(ctx context.Context, name string) (bool, error) {
+	client, ok := m.GetClient(name)
+	if !ok {
+		return false, fmt.Errorf("server not found: %s", name)
+	}
+	return client.CancelOAuthFlow(ctx)
+}
+
+func (m *Manager) StopGateway(ctx context.Context) error {
+	m.gateway.CancelCalls()
+	return m.ShutdownAll(ctx)
+}
diff --git a/internal/upstream/managed/gateway_control.go b/internal/upstream/managed/gateway_control.go
new file mode 100644
index 0000000..7700704
--- /dev/null
+++ b/internal/upstream/managed/gateway_control.go
@@ -0,0 +1,76 @@
+package managed
+
+import (
+	"context"
+	"errors"
+	"sync"
+)
+
+var ErrGatewayPaused = errors.New("GATEWAY_PAUSED: new tool calls are paused")
+
+type GatewayState struct {
+	Paused           bool `json:"paused"`
+	InFlight         int  `json:"in_flight"`
+	IsolatedSessions int  `json:"isolated_sessions"`
+}
+
+// GatewayControl belongs to the upstream manager, and is handed to every
+// managed client. Admission and pause share a mutex so pause cannot report
+// success while a later call sneaks past its boundary.
+type GatewayControl struct {
+	mu       sync.Mutex
+	paused   bool
+	inFlight int
+	nextID   uint64
+	calls    map[uint64]context.CancelFunc
+}
+
+func (g *GatewayControl) SetPaused(paused bool) {
+	g.mu.Lock()
+	g.paused = paused
+	g.mu.Unlock()
+}
+
+func (g *GatewayControl) State() GatewayState {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return GatewayState{Paused: g.paused, InFlight: g.inFlight}
+}
+
+func (mc *Client) SetGatewayControl(g *GatewayControl) {
+	mc.gateway = g
+}
+
+func (g *GatewayControl) EnterContext(parent context.Context) (context.Context, func(), error) {
+	if g == nil {
+		return parent, func() {}, nil
+	}
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.paused {
+		return nil, nil, ErrGatewayPaused
+	}
+	ctx, cancel := context.WithCancel(parent)
+	g.nextID++
+	id := g.nextID
+	if g.calls == nil {
+		g.calls = make(map[uint64]context.CancelFunc)
+	}
+	g.calls[id] = cancel
+	g.inFlight++
+	return ctx, sync.OnceFunc(func() {
+		cancel()
+		g.mu.Lock()
+		delete(g.calls, id)
+		g.inFlight--
+		g.mu.Unlock()
+	}), nil
+}
+func (g *GatewayControl) CancelCalls() {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	g.paused = true
+	for _, cancel := range g.calls {
+		cancel()
+	}
+}
