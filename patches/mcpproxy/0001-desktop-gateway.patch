+++ b/internal/upstream/managed/gateway_control_test.go
@@ -0,0 +1,46 @@
+package managed
+
+import (
+	"context"
+	"errors"
+	"github.com/stretchr/testify/require"
+	"sync"
+	"testing"
+)
+
+func TestGatewayPauseDrainAndForceCancellation(t *testing.T) {
+	var gate GatewayControl
+	ctx, release, err := gate.EnterContext(t.Context())
+	require.NoError(t, err)
+	gate.SetPaused(true)
+	require.Equal(t, 1, gate.State().InFlight)
+	_, _, err = gate.EnterContext(t.Context())
+	require.True(t, errors.Is(err, ErrGatewayPaused))
+	require.NoError(t, ctx.Err(), "pause must let existing work finish")
+	release()
+	release()
+	require.Equal(t, 0, gate.State().InFlight)
+	gate.SetPaused(false)
+	ctx, release, err = gate.EnterContext(t.Context())
+	require.NoError(t, err)
+	gate.CancelCalls()
+	require.ErrorIs(t, ctx.Err(), context.Canceled)
+	release()
+	require.Equal(t, 0, gate.State().InFlight)
+}
+
+func TestGatewayConcurrentAdmissionsAccountExactly(t *testing.T) {
+	var gate GatewayControl
+	var wg sync.WaitGroup
+	for range 100 {
+		wg.Go(func() {
+			_, release, err := gate.EnterContext(t.Context())
+			if err == nil {
+				release()
+				release()
+			}
+		})
+	}
+	wg.Wait()
+	require.Equal(t, 0, gate.State().InFlight)
+}
