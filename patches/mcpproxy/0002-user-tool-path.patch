--- /dev/null
+++ b/internal/secureenv/gateway_path_test.go
@@ -0,0 +1,45 @@
+package secureenv
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+
+	"github.com/smart-mcp-proxy/mcpproxy-go/internal/shellwrap"
+)
+
+func TestGatewayUserToolAlongsideHomebrew(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("macOS login shell regression")
+	}
+	home := t.TempDir()
+	bin := filepath.Join(home, ".local", "bin")
+	if err := os.MkdirAll(bin, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(bin, "gateway-uvx-test"), []byte("#!/bin/sh\nprintf user-tool-found"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HOME", home)
+	t.Setenv("SHELL", "/bin/zsh")
+	t.Setenv("PATH", "/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin")
+	cfg := DefaultEnvConfig()
+	cfg.EnhancePath = true
+	manager := NewManager(cfg)
+	env := manager.BuildSecureEnvironment()
+	shell, args := shellwrap.WrapWithUserShell(nil, "gateway-uvx-test", nil)
+	cmd := exec.CommandContext(t.Context(), shell, args...)
+	cmd.Env = env
+	out, err := cmd.CombinedOutput()
+	if err != nil || string(out) != "user-tool-found" {
+		t.Fatalf("tool launch: %v %s", err, out)
+	}
+	cfg.EnhancePath = false
+	unchanged := manager.buildEnhancedPath(os.Getenv("PATH"))
+	if strings.Contains(unchanged, bin) {
+		t.Fatal("opt-out must remain unchanged")
+	}
+}
